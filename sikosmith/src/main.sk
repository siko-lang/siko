module Main {

import SikoSmith.Runner
import Std.Sys.Process as Sys

fn main() {
    let args = Sys.get_args();
    if args.len() != 2 {
        eprintln_str("usage: sikosmith SEED");
        Sys.exit(1);
    }
    match args[1].parse_int(10) {
        Ok(seed) => Runner.run(seed),
        Err(_) => {
            eprintln_str("invalid seed: ${args[1]}");
            Sys.exit(1);
        }
    }
}

}
