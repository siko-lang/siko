module Std.Effects.Console {

import Std.Console
import Std.Libc.FileDescriptor

pub effect Console {
    fn println(line: String) {
        Std.Console.println(line)
    }

    fn is_terminal() -> Bool {
        get_stdout().is_terminal().expect("is_terminal failed")
    }
}

pub instance StdConsole Console {
    fn println(line: String) {
        Std.Console.println(line)
    }

    fn is_terminal() -> Bool {
        get_stdout().is_terminal().expect("is_terminal failed")
    }
}

}
