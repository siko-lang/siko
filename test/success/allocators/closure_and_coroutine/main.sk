module Main {

import Std.Effects.Allocator
import Std.GC

implicit marker: Int

enum List {
    Nil,
    Cons(Int, List)
}

fn numbers(start: Int) co(Int) -> () {
    yield start;
    yield start + 1;
}

@safe
fn custom_allocate(size: U64) -> void* {
    println(marker);

    let closure = || println(marker + 1);
    closure();

    for n in co numbers(marker + 2) {
        println(n);
    }

    gc_malloc(size)
}

fn main() {
    let n = 73;
    with marker = n, Allocator.allocate = custom_allocate {
        let list = Nil;
    }
}

}
