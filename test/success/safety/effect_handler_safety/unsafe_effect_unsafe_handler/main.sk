module Main {

effect Action {
    @unsafe
    fn perform() {
        let size = sizeof(Int);
    }
}

instance UnsafeHandler Action {
    @unsafe
    fn perform() {
        let size = sizeof(Int);
        println("unsafe");
    }
}

@safe
fn main() {
    with Action = UnsafeHandler {
        perform();
    }
}

}
