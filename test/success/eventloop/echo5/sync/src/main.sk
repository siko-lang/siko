module Main {

import App
import Std.Time as T
import Std.Effects.Spawn
import Std.Effects.Network
import Std.Effects.Time

fn main() {
    let port = 19876.as_u16();
    with TcpNetwork = Tcp, Spawn = ThreadSpawn, Time = ThreadTime {
        spawn(|| server(port));
        spawn(|| client(port));
        Time.sleep(1.seconds());
    }
}

}
