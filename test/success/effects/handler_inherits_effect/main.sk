module Main {

effect Outer {
    fn perform()
}

effect Inner {
    fn perform()
}

fn outer_handler() {
    Inner.perform()
}

fn inner_handler() {
    println("handled")
}

fn call_outer() {
    with Inner.perform = inner_handler {
        Outer.perform()
    }
}

fn main() {
    with Outer.perform = outer_handler {
        call_outer()
    }
}

}
