module Main {

effect Greeter {
    fn greet(name: String) {
        println("default " + name)
    }
}

fn custom_greet(name: String) {
    println("custom " + name)
}

fn call_default() {
    Greeter.greet("one")
}

fn main() {
    call_default();

    with greet = custom_greet {
        Greeter.greet("two")
    }

    Greeter.greet("three")
}

}
