module Main {

effect Logger {
    fn log(message: String)
}

fn write_log() {
    Logger.log("hello")
}

fn console_log(message: String) {
    println(message)
}

@unsafe
fn main() {
    let action: fn*() -> () = write_log;

    // Installing the handler for invocation is too late: function pointers
    // bind their effect handlers when they are created.
    with log = console_log {
        action()
    }
}

}
