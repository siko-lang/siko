module Siko.Constants.Allocator {

import Siko.AST.QualifiedName
import Siko.Constants.Util

pub struct AllocatorNames {
    pub allocate_qn: QualifiedName,
}

pub fn build_allocator_names() -> AllocatorNames {
    let effect_qn = QualifiedName.new_effect(m("Std.Effects.Allocator"), m("Allocator"));
    AllocatorNames(
        allocate_qn: QualifiedName.new_method(effect_qn.name(), m("allocate")),
    )
}

}
