module Siko.Report {

import Siko.Location
import Siko.Diagnostics
import Siko.CompilerHost

pub fn warn(message: String, location: Option[Location]) {
    CompilerDiagnostics.emit(Diagnostic(Severity.Warning, message, location))
}

pub fn report(message: String, location: Option[Location]) {
    CompilerDiagnostics.emit(Diagnostic(Severity.Error, message, location))
}

}
