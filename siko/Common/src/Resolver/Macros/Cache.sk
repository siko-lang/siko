module Siko.Resolver.Macros.Cache {

import Siko.AST.Module as M
import Siko.Interner as I
import Siko.Resolver.Macros.Launcher
import Std.Set

// The resolver asks for cached macro programs, not files. A compiler host may
// persist them, keep them in memory, or disable caching entirely.
pub effect MacroCache {
    fn load(
        macro_module: I.String,
        dependencies: Set[I.String],
        modules: Vec[M.Module],
    ) -> Option[MacroProgram]

    fn store(
        macro_module: I.String,
        dependencies: Set[I.String],
        modules: Vec[M.Module],
        program: MacroProgram,
    )
}

}
