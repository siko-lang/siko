module Siko.PurityCheck.Checker {

import Std.Map
import Std.Set
import Siko.AST.Function
import Siko.AST.QualifiedName
import Siko.HIR.Program
import Siko.Location
import Siko.Config
import Siko.Package.Info
import Siko.PurityCheck.GroupBuilder as GB
import Std.Effects.Console

pub struct ImpureDependency {
    pub name: QualifiedName,
    pub callers: Vec[QualifiedName],
    pub handler_users: Vec[QualifiedName],
}

pub enum PurityError {
    PureInMixedCycle(Location),
    PackageClaimsPure(
        pkg_name: String,
        directly_impure_fns: Vec[QualifiedName],
        impure_dependencies: Vec[ImpureDependency],
    ),
}

pub fn check_purity(program: Program) -> Vec[PurityError] {
    let (sccs, dep_map, handler_map) = GB.build_groups(program);

    let errors: Vec[PurityError] = Vec.new();
    let purity_map: Map[QualifiedName, Bool] = Map.new();

    for scc in sccs {
        let scc_set: Set[QualifiedName] = Set.new();
        for q in scc {
            scc_set.insert(q);
        }

        // a @pure function in a mixed cycle is a contradiction — fail early
        if scc.len() > 1 {
            let has_pure = False;
            let all_pure = True;
            for q in scc {
                let func = program.functions.get(q).unwrap();
                if func.is_pure() {
                    has_pure = True;
                } else {
                    all_pure = False;
                }
            }
            if has_pure && !all_pure {
                for q in scc {
                    let func = program.functions.get(q).unwrap();
                    if func.is_pure() {
                        errors.push(PurityError.PureInMixedCycle(func.name.location));
                    }
                }
                for q in scc {
                    purity_map.insert(q, False);
                }
                continue;
            }
        }

        let scc_pure = True;

        for qname in scc {
            let func = program.functions.get(qname).unwrap();

            if func.is_pure() {
                purity_map.insert(qname, True);
                continue;
            }

            if func.is_unsafe() || func.is_safe() || func.is_extern() || func.is_builtin() {
                scc_pure = False;
                continue;
            }

            let deps = dep_map.get(qname).unwrap_or([]);
            for dep in deps {
                if scc_set.contains(dep) {
                    continue;
                }
                if let Some(dep_func) = program.functions.get(dep) {
                    if dep_func.kind == FunctionDefKind.EffectMethod {
                        continue;
                    }
                }
                if !purity_map.get(dep).unwrap_or(False) {
                    scc_pure = False;
                }
            }
        }

        for qname in scc {
            let func = program.functions.get(qname).unwrap();
            if !func.is_pure() {
                purity_map.insert(qname, scc_pure);
            }
        }
    }

    // aggregate by package — a package is pure only if every function in it is pure
    let package_purity: Map[String, Bool] = Map.new();
    let package_info: Map[String, PackageInfo] = Map.new();
    let package_directly_impure_fns: Map[String, Vec[QualifiedName]] = Map.new();
    let package_impure_dependencies: Map[String, Map[QualifiedName, ImpureDependency]] = Map.new();

    for (qname, _) in program.functions {
        let func = program.functions.get(qname).unwrap();
        let pkg = match func.source_package {
            Some(p) => p,
            None => continue,
        };
        let pkg_name = pkg.info.name;
        package_info.insert(pkg_name, pkg.info);
        let fn_pure = purity_map.get(qname).unwrap_or(False);
        if !fn_pure {
            if func.is_unsafe() || func.is_safe() || func.is_extern() || func.is_builtin() {
                let directly_impure_fns = package_directly_impure_fns
                    .entry(pkg_name)
                    .or_insert_with(|| Vec.new());
                directly_impure_fns.push(qname);
            }

            let deps = dep_map.get(qname).unwrap_or([]);
            for dep in deps {
                let dep_func = match program.functions.get(dep) {
                    Some(f) => f,
                    None => continue,
                };
                if dep_func.kind == FunctionDefKind.EffectMethod {
                    continue;
                }
                if purity_map.get(dep).unwrap_or(False) {
                    continue;
                }
                let outside_package = match dep_func.source_package {
                    Some(dep_pkg) => dep_pkg.info.name != pkg_name,
                    None => True,
                };
                if !outside_package {
                    continue;
                }

                let dependencies = package_impure_dependencies
                    .entry(pkg_name)
                    .or_insert_with(|| Map.new());
                let dependency = dependencies.entry(dep).or_insert_with(||
                    ImpureDependency(
                        name: dep,
                        callers: Vec.new(),
                        handler_users: Vec.new(),
                    )
                );
                let is_handler = handler_map.get(qname)
                    .map(|handlers| handlers.contains(dep))
                    .unwrap_or(False);
                if is_handler {
                    dependency.handler_users.push(qname);
                } else {
                    dependency.callers.push(qname);
                }
            }
        }
        match package_purity.get(pkg_name) {
            Some(_) => {
                if !fn_pure {
                    package_purity.insert(pkg_name, False);
                }
            }
            None => {
                package_purity.insert(pkg_name, fn_pure);
            }
        }
    }

    let dump = get_config().dump_package_purity;
    for (pkg_name, is_pure) in package_purity {
        if dump {
            let verdict = if is_pure { "PURE" } else { "IMPURE" };
            println("${verdict}: ${pkg_name}");
        }
        let advertised = match package_info.get(pkg_name) {
            Some(info) => info.pure,
            None => False,
        };
        if advertised && !is_pure {
            let directly_impure_fns = package_directly_impure_fns
                .get(pkg_name)
                .unwrap_or([]);
            directly_impure_fns.sort();
            let impure_dependencies: Vec[ImpureDependency] = match package_impure_dependencies.get(pkg_name) {
                Some(dependencies) => dependencies.values().collect(),
                None => Vec.new(),
            };
            for dependency in impure_dependencies {
                dependency.callers.sort();
                dependency.handler_users.sort();
            }
            errors.push(PurityError.PackageClaimsPure(
                pkg_name: pkg_name,
                directly_impure_fns: directly_impure_fns,
                impure_dependencies: impure_dependencies,
            ));
        }
    }

    errors
}

}
