module Siko.EffectChecker.Error {

import Siko.AST.QualifiedName
import Siko.Location

@derive(Clone)
pub enum EffectError {
    UnresolvedEffectHandler(method: QualifiedName, location: Location),
    UnsetImplicit(implicit_name: QualifiedName, location: Location),
    UnboundEffectAssociatedType(associated_type: QualifiedName, location: Location),
    InvalidEffectSignatureBound(function: QualifiedName, location: Location),
    EffectSignatureMismatch(
        function: QualifiedName,
        declared: String,
        inferred: String,
        location: Location,
    ),
    EffectImplementationSignatureMismatch(
        implementation: QualifiedName,
        declaration: QualifiedName,
        declared: String,
        inferred: String,
        location: Location,
    ),
}

}
