module Siko.AST.EffectSignature {

import Siko.AST.Name
import Siko.AST.Type
import Siko.Location

@derive(Clone, PartialEq, Eq)
pub struct EffectSignature {
    pub entries: Vec[EffectSignatureEntry],
    pub open: Bool,
    pub location: Location,
}

@derive(Clone, PartialEq, Eq)
pub enum EffectSignatureEntry {
    Effect(target: Name, scope: Option[EffectSignature]),
    Implicit(name: Name),
    AssociatedType(name: Name),
    Bound(
        trait_name: Name,
        type_args: Vec[TypeDef],
        method: Name,
        scope: Option[EffectSignature],
    ),
}

}
