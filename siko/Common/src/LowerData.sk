module Siko.LowerData {

import Std.Map
import Siko.AST.Expr
import Siko.AST.Statement as S
import Siko.AST.Type
import Siko.AST.Data
import Siko.AST.Function
import Siko.AST.Generics
import Siko.AST.Name
import Siko.AST.Pattern
import Siko.AST.Identifier
import Siko.AST.QualifiedName
import Siko.HIR.Program
import Siko.Location
import Siko.Constants.Builtins as B
import Siko.VariantPayloads as VP
import Siko.Layout
import Siko.Utils.VarAllocator
import Siko.Utils.LabelAllocator
import Siko.Interner as I

// Converts enums into plain structs. Every enum becomes a container struct
// { tag: U32, payload: uintN[count] } where N is the maximum alignment of the
// stored variant payloads and count * N covers the largest payload including
// its padding. Both value and heap enums store the payload inline; a heap enum
// therefore needs one allocation for the whole container. The container is
// inserted into Program.structs under the enum's own qname; Program.enums is
// kept as metadata for constructor synthesis.
//
// Expression rewrites (bodies are in post-lower-pointers basic block form):
//   EnumTag(v)         -> Transmute(v.tag): Int
//   Discriminator(v)   -> same as EnumTag for enums, literal 0 otherwise
//   ReadVariant(v, _)  -> *(P*)&v.payload   (Deref(Transmute(AddrOf(FieldAccess))))
//
// The pass also materializes every struct and variant constructor as a real
// Program function (under QualifiedName.new_ctor) and rewrites ctor call
// sites to plain UserDefined calls, so the backend synthesizes no function
// bodies at all. Non-value constructors initialize caller-provided storage;
// their call sites use ExprKind.Alloc to choose heap storage.
//
// After this pass no downstream stage knows what an enum is: the C backend
// needs no unions, and match dispatch is a switch on an ordinary field.

struct EnumLowerer {
    program: Program,
    int_ty: TypeDef,
    u32_ty: TypeDef,
    // Container payload field type per enum; absent when the enum has no payload.
    payload_types: Map[QualifiedName, TypeDef],
    var_alloc: VarAllocator,

    // ─── Rewrite helpers ──────────────────────────────────────────────────────

    // `expr.tag` as a Siko Int, matching what EnumTag used to produce.
    fn tag_read(l: EnumLowerer, inner: Expr, loc: Location) -> Expr {
        let fa = Expr(
            ExprKind.FieldAccess(inner, Identifier.new(VP.container_tag_name(), loc), Some(0)),
            loc,
            Some(l.u32_ty),
        );
        Expr(ExprKind.Transmute(fa), loc, Some(l.int_ty))
    }

    // `*(P*)&value.payload` typed as the inline ReadVariant result.
    fn payload_read(l: EnumLowerer, value: Expr, result_ty: TypeDef, loc: Location) -> Expr {
        let enum_qname = match named_qname(value.ty) {
            Some(qname) => qname,
            None => panic("lower-data: ReadVariant scrutinee is not an enum type"),
        };
        let payload_ty = match l.payload_types.get(enum_qname) {
            Some(ty) => ty,
            None => panic("lower-data: ReadVariant on payload-less enum"),
        };
        let fa = Expr(
            ExprKind.FieldAccess(value, Identifier.new(VP.container_payload_name(), loc), Some(1)),
            loc,
            Some(payload_ty),
        );
        let addr = Expr(ExprKind.AddrOf(fa), loc, Some(TypeDef.Ptr(payload_ty)));
        let cast = Expr(ExprKind.Transmute(addr), loc, Some(TypeDef.Ptr(result_ty)));
        Expr(ExprKind.Deref(cast), loc, Some(result_ty))
    }

    // A constructor returning Ptr(T) constructs a non-value datatype.
    fn heap_ctor_pointee(l: EnumLowerer, expr: Expr) -> Option[TypeDef] {
        match expr.kind {
            ExprKind.FunctionCall(info) => {
                match info.kind {
                    FunctionKind.StructCtor | FunctionKind.VariantCtor => {
                        match expr.ty {
                            Some(TypeDef.Ptr(pointee)) => Some(pointee),
                            _ => None,
                        }
                    }
                    _ => None,
                }
            }
            _ => None,
        }
    }

    fn placement_ctor_call(l: EnumLowerer, expr: Expr, destination: Expr) -> Expr {
        let loc = expr.location;
        let ty = expr.ty;
        match expr.kind {
            ExprKind.FunctionCall(info) => {
                match info.kind {
                    FunctionKind.StructCtor | FunctionKind.VariantCtor => {}
                    _ => panic("lower-data: placement target is not a constructor"),
                }
                info.args = info.args.rewrite(l);
                info.args.insert(0, destination);
                info.qname = QualifiedName.new_ctor(info.qname);
                info.kind = FunctionKind.UserDefined;
                Expr(ExprKind.FunctionCall(info), loc, ty)
            }
            _ => panic("lower-data: placement target is not a call"),
        }
    }
}

// ─── Automatic traversal ─────────────────────────────────────────────────────
//
// LowerData changes a handful of expression forms and can expand constructor
// statements, but it has no business defining which surrounding HIR shapes
// are legal. auto(Map) owns that traversal so structured control flow and new
// expression containers are visited without another hand-maintained walker.

trait Rewrite[T] {
    fn rewrite(value: T, lowerer: EnumLowerer) -> T
}

instance Rewrite[TypeDef] {
    fn rewrite(ty: TypeDef, lowerer: EnumLowerer) -> TypeDef { ty }
}

instance Rewrite[Location]          = auto(Map, =)
instance Rewrite[I.String]          = auto(Map, =)
instance Rewrite[String]            = auto(Map, =)
instance Rewrite[Int]               = auto(Map, =)
instance Rewrite[U8]                = auto(Map, =)
instance Rewrite[Bool]              = auto(Map, =)
instance Rewrite[QualifiedName]     = auto(Map, =)
instance Rewrite[VariableName]      = auto(Map, =)
instance Rewrite[Name]              = auto(Map, =)
instance Rewrite[Identifier]        = auto(Map, =)
instance Rewrite[FunctionKind]      = auto(Map, =)
instance Rewrite[BinaryOp]          = auto(Map, =)
instance Rewrite[UnaryOp]           = auto(Map, =)
instance Rewrite[AtomicOrdering]    = auto(Map, =)
instance Rewrite[AtomicRmwOp]       = auto(Map, =)
instance Rewrite[WitnessInfo]       = auto(Map, =)
instance Rewrite[HandlerSelection]  = auto(Map, =)
instance Rewrite[ImplicitRefInfo]   = auto(Map, =)
instance Rewrite[CreateClosureInfo] = auto(Map, =)
instance Rewrite[FunctionPtrInfo]   = auto(Map, =)
instance Rewrite[LambdaArg]         = auto(Map, =)
instance Rewrite[TypeArgDefs]       = auto(Map, =)
instance Rewrite[MethodMap]         = auto(Map, =)
instance Rewrite[FunctionArg]       = auto(Map)
instance Rewrite[Pattern]           = auto(Map)
instance Rewrite[PatternKind]       = auto(Map)
instance Rewrite[FunctionCallInfo]       = auto(Map)
instance Rewrite[TypeAssociatedCallInfo] = auto(Map, !)
instance Rewrite[NamedArgument]          = auto(Map, =)
instance Rewrite[NamedPatternArg]        = auto(Map, =)
instance Rewrite[NamedPatternInfo]       = auto(Map)
instance Rewrite[MethodCallInfo]         = auto(Map)
instance Rewrite[CallInfo]               = auto(Map)
instance Rewrite[WithInfo]               = auto(Map)
instance Rewrite[MatchArm]               = auto(Map)
instance Rewrite[S.LetInfo]              = auto(Map)
instance Rewrite[S.DeclareInfo]          = auto(Map)
instance Rewrite[S.Statement]            = auto(Map)
instance Rewrite[MatchInfo]              = auto(Map)
instance Rewrite[YieldInfo]              = auto(Map)
instance Rewrite[ExprKind]               = auto(Map)

instance[T: Rewrite[T]] Rewrite[Option[T]] {
    fn rewrite(value: Option[T], lowerer: EnumLowerer) -> Option[T] {
        value.map(|v| rewrite(v, lowerer))
    }
}

instance[T: Rewrite[T]] Rewrite[Vec[T]] {
    fn rewrite(values: Vec[T], lowerer: EnumLowerer) -> Vec[T] {
        values.into_iter().map(|v| rewrite(v, lowerer)).collect()
    }
}

instance Rewrite[Expr] {
    fn rewrite(expr: Expr, l: EnumLowerer) -> Expr {
        let loc = expr.location.clone();
        let ty = expr.ty.clone();
        match expr.kind {
            ExprKind.EnumTag(inner) => return l.tag_read(inner.rewrite(l), loc),
            ExprKind.Discriminator(inner) => {
                let is_enum = match named_qname(inner.ty) {
                    Some(qname) => l.program.enums.contains_key(qname),
                    None => False,
                };
                if is_enum {
                    return l.tag_read(inner.rewrite(l), loc);
                }
                return Expr(ExprKind.IntLiteral(I.intern("0"), Some(0)), loc, Some(l.int_ty));
            }
            ExprKind.ReadVariant(value, _) => {
                let result_ty = ty.expect("lower-data: ReadVariant has no type");
                return l.payload_read(value.rewrite(l), result_ty, loc);
            }
            ExprKind.FunctionCall(info) => {
                info.args = info.args.rewrite(l);
                match info.kind {
                    FunctionKind.StructCtor | FunctionKind.VariantCtor => {
                        match ty {
                            Some(TypeDef.Ptr(_)) =>
                                panic("lower-data: heap constructor outside statement position"),
                            _ => {}
                        }
                        info.qname = QualifiedName.new_ctor(info.qname);
                        info.kind = FunctionKind.UserDefined;
                    }
                    _ => {}
                }
                Expr(ExprKind.FunctionCall(info), loc, ty)
            }
            kind => Expr(kind.rewrite(l), loc, ty),
        }
    }
}

instance Rewrite[BlockInfo] {
    fn rewrite(block: BlockInfo, l: EnumLowerer) -> BlockInfo {
        let out: Vec[S.Statement] = Vec.new();
        for stmt in block.stmts {
            match stmt {
                S.Statement.Let(info) => {
                    match l.heap_ctor_pointee(info.rhs) {
                        Some(pointee) => {
                            let loc = info.rhs.location;
                            let ptr_ty = TypeDef.Ptr(pointee);
                            let alloc = Expr(ExprKind.Alloc(pointee), loc, Some(ptr_ty));
                            let destination = Expr(ExprKind.Var(info.name), loc, Some(ptr_ty));
                            let call = l.placement_ctor_call(info.rhs, destination);
                            out.push(S.Statement.Let(S.LetInfo(info.name, info.ty, alloc)));
                            out.push(S.Statement.Expr(call));
                        }
                        None => {
                            out.push(S.Statement.Let(info.rewrite(l)));
                        }
                    }
                }
                S.Statement.Expr(e) => {
                    match l.heap_ctor_pointee(e) {
                        Some(pointee) => {
                            let loc = e.location;
                            let ptr_ty = TypeDef.Ptr(pointee);
                            let destination_name = l.var_alloc.allocate_temp();
                            let alloc = Expr(ExprKind.Alloc(pointee), loc, Some(ptr_ty));
                            let destination = Expr(ExprKind.Var(destination_name), loc, Some(ptr_ty));
                            let call = l.placement_ctor_call(e, destination);
                            out.push(S.Statement.Let(S.LetInfo(destination_name, Some(ptr_ty), alloc)));
                            out.push(S.Statement.Expr(call));
                        }
                        None => out.push(S.Statement.Expr(e.rewrite(l))),
                    }
                }
                _ => out.push(stmt.rewrite(l)),
            }
        }
        BlockInfo(out)
    }
}

// ─── Constructor generation ───────────────────────────────────────────────────
//
// Bodies are straight-line statement lists in the post-basic-block form the
// backend consumes: Declare/Let + field assigns + Return. Params and locals
// are allocator temps, so names never collide.

struct CtorBuilder {
    var_alloc: VarAllocator,
    stmts: Vec[S.Statement],
    loc: Location,

    fn var_expr(b: CtorBuilder, name: VariableName, ty: TypeDef) -> Expr {
        Expr(ExprKind.Var(name), b.loc, Some(ty))
    }

    fn field_access(b: CtorBuilder, receiver: Expr, name: I.String, field_index: Int, ty: TypeDef) -> Expr {
        Expr(
            ExprKind.FieldAccess(receiver, Identifier.new(name, b.loc), Some(field_index)),
            b.loc,
            Some(ty),
        )
    }

    fn new_local(b: CtorBuilder, ty: TypeDef) -> VariableName {
        let name = b.var_alloc.allocate_temp();
        b.stmts.push(S.Statement.Declare(S.DeclareInfo(name, Some(ty))));
        name
    }

    fn assign_field(b: CtorBuilder, receiver: Expr, field: I.String, field_index: Int, value: Expr) {
        let field_ty = value.ty.expect("lower-data: ctor field value has no type");
        b.stmts.push(S.Statement.Assign(b.field_access(receiver, field, field_index, field_ty), value));
    }

    fn ret(b: CtorBuilder, value: Expr) {
        b.stmts.push(S.Statement.Expr(Expr(ExprKind.Return(value), b.loc, Some(TypeDef.Void))));
    }
}

// Shared scaffolding: builds the FunctionDef around a generated ctor body.
fn make_ctor_fn(owner: QualifiedName, module_name: I.String, params: Vec[FunctionArg], ret_ty: TypeDef, b: CtorBuilder) -> (QualifiedName, FunctionDef) {
    let ctor_qn = QualifiedName.new_ctor(owner);
    let body = Expr(ExprKind.Block(BlockInfo(b.stmts)), b.loc, Some(ret_ty));
    let fdef = FunctionDef(
        annotations: Vec.new(),
        public: False,
        name: Identifier.new(I.intern("ctor"), b.loc),
        qualified_name: Some(ctor_qn),
        kind: FunctionDefKind.Regular,
        type_arg_defs: None,
        args: params,
        yield_type: None,
        result_type: Some(ret_ty),
        body: Some(body),
        module_name: module_name,
        var_allocator: b.var_alloc,
        label_allocator: LabelAllocator.new(),
        is_varargs: False,
        default_value_names: Vec.new(),
        source_package: None,
    );
    (ctor_qn, fdef)
}

fn generate_struct_ctor(sdef: StructDef) -> (QualifiedName, FunctionDef) {
    let qname = sdef.qualified_name.unwrap();
    let is_heap = !sdef.value_type;
    let struct_ty = TypeDef.Named(NamedInfo(Name.inner(qname), []));
    let ret_ty = if is_heap { TypeDef.Ptr(struct_ty) } else { struct_ty };
    let b = CtorBuilder(VarAllocator.new(), Vec.new(), sdef.name.location);
    let params: Vec[FunctionArg] = Vec.new();
    let param_names: Vec[VariableName] = Vec.new();
    let caller_destination = if is_heap {
        let name = b.var_alloc.allocate_temp();
        params.push(FunctionArg(name: name, type_def: ret_ty, default_value: None));
        Some(name)
    } else {
        None
    };
    for field in sdef.fields.iter() {
        let name = b.var_alloc.allocate_temp();
        params.push(FunctionArg(name: name, type_def: field.ty, default_value: None));
        param_names.push(name);
    }
    let result = match caller_destination {
        Some(name) => name,
        None => b.new_local(ret_ty),
    };
    for (i, field) in sdef.fields.iter().enumerate() {
        b.assign_field(
            b.var_expr(result, ret_ty),
            field.name.name(),
            i,
            b.var_expr(param_names[i], field.ty),
        );
    }
    b.ret(b.var_expr(result, ret_ty));
    make_ctor_fn(qname, sdef.module_name, params, ret_ty, b)
}

fn generate_variant_ctor(edef: EnumDef, variant: VariantDef, tag: Int, payload_types: Map[QualifiedName, TypeDef], u32_ty: TypeDef) -> (QualifiedName, FunctionDef) {
    let enum_qname = edef.qualified_name.unwrap();
    let is_heap = !edef.value_type;
    let enum_named = TypeDef.Named(NamedInfo(Name.inner(enum_qname), []));
    let ret_ty = if is_heap { TypeDef.Ptr(enum_named) } else { enum_named };
    let payload_named = VP.payload_type(enum_qname, variant);
    let has_payload = !variant.items.is_empty();

    let b = CtorBuilder(VarAllocator.new(), Vec.new(), variant.name.location);
    let params: Vec[FunctionArg] = Vec.new();
    let param_names: Vec[VariableName] = Vec.new();
    let caller_destination = if is_heap {
        let name = b.var_alloc.allocate_temp();
        params.push(FunctionArg(name: name, type_def: ret_ty, default_value: None));
        Some(name)
    } else {
        None
    };
    for item in variant.items.iter() {
        let name = b.var_alloc.allocate_temp();
        params.push(FunctionArg(name: name, type_def: item.ty, default_value: None));
        param_names.push(name);
    }

    let result = match caller_destination {
        Some(name) => name,
        None => b.new_local(ret_ty),
    };
    b.assign_field(
        b.var_expr(result, ret_ty),
        VP.container_tag_name(),
        0,
        Expr(ExprKind.IntLiteral(I.intern("${tag}"), Some(tag)), b.loc, Some(u32_ty)),
    );
    if has_payload {
        // Treat the container's byte buffer as the concrete payload struct and
        // initialize its fields in place.
        let buffer_ty = payload_types
            .get(enum_qname)
            .expect("lower-data: variant with payload but container has no payload field");
        let fa = b.field_access(b.var_expr(result, ret_ty), VP.container_payload_name(), 1, buffer_ty);
        let addr = Expr(ExprKind.AddrOf(fa), b.loc, Some(TypeDef.Ptr(buffer_ty)));
        let cast = Expr(ExprKind.Transmute(addr), b.loc, Some(TypeDef.Ptr(payload_named)));
        let payload = Expr(ExprKind.Deref(cast), b.loc, Some(payload_named));
        for (i, item) in variant.items.iter().enumerate() {
            b.assign_field(
                payload,
                VP.payload_field_name(i),
                i,
                b.var_expr(param_names[i], item.ty),
            );
        }
    }
    b.ret(b.var_expr(result, ret_ty));
    make_ctor_fn(variant.qualified_name.unwrap(), edef.module_name, params, ret_ty, b)
}

// The named type behind a (possibly Ptr-wrapped) type.
fn named_qname(ty: Option[TypeDef]) -> Option[QualifiedName] {
    match ty {
        Some(TypeDef.Named(NamedInfo(name, _))) => Some(name.resolved()),
        Some(TypeDef.Ptr(TypeDef.Named(NamedInfo(name, _)))) => Some(name.resolved()),
        _ => None,
    }
}

fn builtin_ty(qname: QualifiedName) -> TypeDef {
    TypeDef.Named(NamedInfo(Name.inner(qname), []))
}

fn payload_elem_ty(elem_align: Int) -> TypeDef {
    let qname = match elem_align {
        1 => B.get_u8_type_qn().as_mono(),
        2 => B.get_u16_type_qn().as_mono(),
        4 => B.get_u32_type_qn().as_mono(),
        8 => B.get_u64_type_qn().as_mono(),
        n => panic("lower-data: unsupported payload alignment ${n}"),
    };
    builtin_ty(qname)
}

// ─── Entry point ──────────────────────────────────────────────────────────────

pub fn lower_data(program: Program) {
    // Bool's tags are published as constants (Builtins' variant index
    // helpers) so passes may rely on them; verify std's declaration order
    // still matches before baking the tags into generated code.
    if let Some(bool_def) = program.enums.get(B.get_bool_type_qn().as_mono()) {
        let false_qn = bool_def.variants[B.get_bool_false_variant_index()].qualified_name.unwrap();
        let true_qn = bool_def.variants[B.get_bool_true_variant_index()].qualified_name.unwrap();
        if false_qn != B.get_bool_false_qn().as_mono() || true_qn != B.get_bool_true_qn().as_mono() {
            panic("lower-data: Bool variant order does not match Builtins' variant indices: index ${B.get_bool_false_variant_index()} is ${I.resolve(false_qn.name())}, index ${B.get_bool_true_variant_index()} is ${I.resolve(true_qn.name())}");
        }
    }
    let engine = LayoutEngine.new(program);
    let int_ty = builtin_ty(B.get_int_type_qn().as_mono());
    let u32_ty = builtin_ty(B.get_u32_type_qn().as_mono());

    // Build one container struct per enum.
    let payload_types: Map[QualifiedName, TypeDef] = Map.new();
    let containers: Map[QualifiedName, StructDef] = Map.new();
    for edef in program.enums.values() {
        let qname = edef.qualified_name.unwrap();
        let shape = engine.payload_shape(edef);
        let loc = edef.name.location;
        let fields: Vec[FieldDef] = Vec.new();
        fields.push(FieldDef(
            False,
            Identifier.new(VP.container_tag_name(), loc),
            u32_ty,
            None,
        ));
        if shape.count > 0 {
            let payload_ty = TypeDef.Array(payload_elem_ty(shape.elem_align), shape.count);
            fields.push(FieldDef(
                False,
                Identifier.new(VP.container_payload_name(), loc),
                payload_ty,
                None,
            ));
            payload_types.insert(qname, payload_ty);
        }
        containers.insert(
            qname,
            StructDef(
                annotations: [],
                public: False,
                name: Identifier.new(qname.name(), loc),
                qualified_name: Some(qname),
                type_arg_defs: None,
                fields: fields,
                all_fields_public: False,
                methods: [],
                method_map: MethodMap.new(),
                module_name: I.intern(""),
                default_value_names: Vec.new(),
                value_type: edef.value_type,
            ),
        );
    }
    program.structs.extend(containers);

    // Rewrite every function body.
    let l = EnumLowerer(program, int_ty, u32_ty, payload_types, VarAllocator.new());
    let fn_keys: Vec[QualifiedName] = program.functions.keys().collect();
    for key in fn_keys {
        let func = program.functions.get(key).unwrap();
        if let Some(body) = func.body {
            l.var_alloc = func.var_allocator;
            func.body = Some(body.rewrite(l));
            program.functions.insert(key, func);
        }
    }

    // Materialize every constructor as a real function; call sites were
    // rewritten to UserDefined calls against these qnames above.
    let ctor_fns: Map[QualifiedName, FunctionDef] = Map.new();
    for sdef in program.structs.values() {
        if sdef.is_builtin() {
            continue;
        }
        let qname = sdef.qualified_name.unwrap();
        // Payload structs are only built inside variant ctors; enum
        // containers are built by them.
        if VP.is_payload_qname(qname) || program.enums.contains_key(qname) {
            continue;
        }
        let (ctor_qn, fdef) = generate_struct_ctor(sdef);
        ctor_fns.insert(ctor_qn, fdef);
    }
    for edef in program.enums.values() {
        for (tag, variant) in edef.variants.iter().enumerate() {
            let (ctor_qn, fdef) = generate_variant_ctor(edef, variant, tag, payload_types, u32_ty);
            ctor_fns.insert(ctor_qn, fdef);
        }
    }
    program.functions.extend(ctor_fns);
}

}
