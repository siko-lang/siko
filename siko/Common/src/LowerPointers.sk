module Siko.LowerPointers {

import Std.Map
import Siko.AST.Annotations
import Siko.AST.Expr
import Siko.AST.EffectSignature
import Siko.AST.Statement as S
import Siko.AST.Type
import Siko.AST.Data
import Siko.AST.Function
import Siko.AST.Generics
import Siko.AST.Identifier
import Siko.AST.Name
import Siko.AST.Pattern
import Siko.AST.QualifiedName
import Siko.HIR.Program
import Siko.Format.Utils
import Siko.Interner as I
import Siko.Location
import Siko.Package.Source as SP
import Siko.Utils.LabelAllocator
import Siko.Utils.VarAllocator

// Makes heap representation explicit in the types: after this pass a
// TypeDef.Named always means an inline (by-value) struct and every heap
// (non-value-type) datatype appears as TypeDef.Ptr(Named).

struct PointerLowerer {
    program: Program,

    fn is_heap(l: PointerLowerer, qname: QualifiedName) -> Bool {
        if let Some(sdef) = l.program.structs.get(qname) {
            return !sdef.value_type;
        }
        if let Some(edef) = l.program.enums.get(qname) {
            return !edef.value_type;
        }
        panic("lower-pointers: unknown named type ${qname.hashed()}")
    }
}

trait Rewrite[T] {
    fn rewrite(value: T, lowerer: PointerLowerer) -> T
}

instance Rewrite[Location]          = auto(Map, =)
instance Rewrite[EffectSignature]   = auto(Map, =)
instance Rewrite[I.String]          = auto(Map, =)
instance Rewrite[String]            = auto(Map, =)
instance Rewrite[Int]               = auto(Map, =)
instance Rewrite[AtomicOrdering]    = auto(Map, =)
instance Rewrite[AtomicRmwOp]       = auto(Map, =)
instance Rewrite[U8]                = auto(Map, =)
instance Rewrite[Bool]              = auto(Map, =)
instance Rewrite[QualifiedName]     = auto(Map, =)
instance Rewrite[VariableName]      = auto(Map, =)
instance Rewrite[Name]              = auto(Map, =)
instance Rewrite[Identifier]        = auto(Map, =)
instance Rewrite[FunctionKind]      = auto(Map, =)
instance Rewrite[FunctionDefKind]   = auto(Map, =)
instance Rewrite[BinaryOp]          = auto(Map, =)
instance Rewrite[UnaryOp]           = auto(Map, =)
instance Rewrite[WitnessInfo]       = auto(Map, =)
instance Rewrite[Annotation]        = auto(Map, =)
instance Rewrite[TypeArgDefs]       = auto(Map, =)
instance Rewrite[DefaultValueInfo]  = auto(Map, =)
instance Rewrite[MethodMap]         = auto(Map, =)
instance Rewrite[VarAllocator]      = auto(Map, =)
instance Rewrite[LabelAllocator]    = auto(Map, =)
instance Rewrite[SP.SourcePackage]  = auto(Map, =)
instance Rewrite[NamedArgument]     = auto(Map, =)
instance Rewrite[NamedPatternArg]   = auto(Map, =)

instance Rewrite[HandlerSelection]        = auto(Map)
instance Rewrite[AllocationInfo]          = auto(Map)
instance Rewrite[ImplicitRefInfo]         = auto(Map)
instance Rewrite[CreateClosureInfo]       = auto(Map)
instance Rewrite[FunctionPtrInfo]         = auto(Map)
instance Rewrite[LambdaArg]               = auto(Map)
instance Rewrite[FunctionCallInfo]        = auto(Map)
instance Rewrite[TypeAssociatedCallInfo]  = auto(Map)
instance Rewrite[MethodCallInfo]          = auto(Map)
instance Rewrite[CallInfo]                = auto(Map)
instance Rewrite[WithInfo]                = auto(Map)
instance Rewrite[MatchInfo]               = auto(Map)
instance Rewrite[MatchArm]                = auto(Map)
instance Rewrite[YieldInfo]               = auto(Map)
instance Rewrite[Pattern]                 = auto(Map)
instance Rewrite[PatternKind]             = auto(Map)
instance Rewrite[NamedPatternInfo]        = auto(Map)
instance Rewrite[BlockInfo]               = auto(Map)
instance Rewrite[Expr]                    = auto(Map)
instance Rewrite[ExprKind]                = auto(Map)
instance Rewrite[S.LetInfo]               = auto(Map)
instance Rewrite[S.DeclareInfo]           = auto(Map)
instance Rewrite[S.Statement]             = auto(Map)
instance Rewrite[FunctionArg]             = auto(Map)
instance Rewrite[FunctionDef]             = auto(Map)
instance Rewrite[FieldDef]                = auto(Map)
instance Rewrite[StructDef]               = auto(Map)
instance Rewrite[ItemInfo]                = auto(Map)
instance Rewrite[VariantDef]              = auto(Map)
instance Rewrite[EnumDef]                 = auto(Map)

instance Rewrite[TypeDef] {
    fn rewrite(ty: TypeDef, lowerer: PointerLowerer) -> TypeDef {
        match ty {
            TypeDef.Named(NamedInfo(name, args)) => {
                // Type args are instantiation metadata (the mono qname already
                // encodes them); representation applies to the type itself only.
                let named = TypeDef.Named(NamedInfo(name, args));
                if lowerer.is_heap(name.resolved()) {
                    TypeDef.Ptr(named)
                } else {
                    named
                }
            }
            TypeDef.Ptr(inner) => TypeDef.Ptr(rewrite(inner, lowerer)),
            TypeDef.FnPtr(params, ret) => TypeDef.FnPtr(
                rewrite(params, lowerer),
                rewrite(ret, lowerer),
            ),
            TypeDef.Array(inner, n) => TypeDef.Array(rewrite(inner, lowerer), n),
            TypeDef.Paren(inner) => rewrite(inner, lowerer),
            TypeDef.Never(_) | TypeDef.Void | TypeDef.VoidPtr | TypeDef.Numeric(_) => ty,
            ty => panic("lower-pointers: unexpected type ${format_type(ty)}"),
        }
    }
}

instance[T: Rewrite[T]] Rewrite[Option[T]] {
    fn rewrite(value: Option[T], lowerer: PointerLowerer) -> Option[T] {
        value.map(|v| rewrite(v, lowerer))
    }
}

instance[T: Rewrite[T]] Rewrite[Vec[T]] {
    fn rewrite(values: Vec[T], lowerer: PointerLowerer) -> Vec[T] {
        values.into_iter().map(|v| rewrite(v, lowerer)).collect()
    }
}

instance[K, V: Rewrite[V], Ord[K]] Rewrite[Map[K, V]] {
    fn rewrite(values: Map[K, V], lowerer: PointerLowerer) -> Map[K, V] {
        values.iter().map(|(key, value)| (key, rewrite(value, lowerer))).collect()
    }
}

pub fn lower_pointers(program: Program) {
    let lowerer = PointerLowerer(program);

    program.structs = rewrite(program.structs, lowerer);
    program.enums = rewrite(program.enums, lowerer);
    program.functions = rewrite(program.functions, lowerer);
}

}
